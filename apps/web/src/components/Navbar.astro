---
---

<nav class="border-b border-radar-border/80 bg-radar-surface/90 bg-radar-nav backdrop-blur-md sticky top-0 z-40 transition-colors" aria-label="Main Navigation">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between">
    <!-- Logo & Wordmark -->
    <a href="/" class="flex items-center gap-2.5 group focus:outline-none focus:ring-2 focus:ring-coconut-500 rounded-lg p-1">
      <div class="w-8 h-8 rounded-lg bg-coconut-500/15 border border-coconut-500/30 flex items-center justify-center text-coconut-400 group-hover:bg-coconut-500/25 transition">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="m4.93 4.93 4.24 4.24"></path>
          <circle cx="12" cy="12" r="2"></circle>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-bold tracking-tight font-display text-white text-adaptive-title group-hover:text-coconut-400 transition leading-none">
          HACKRADAR <span class="text-transparent bg-clip-text bg-gradient-to-r from-coconut-400 to-kasavu-400">KL</span>
        </span>
        <span class="text-[10px] font-mono text-neutral-300 text-adaptive-muted leading-tight">Kerala Hackathons</span>
      </div>
    </a>

    <!-- Navigation Links & Theme Toggle -->
    <div class="flex items-center gap-1 sm:gap-4 text-xs font-mono">
      <a href="#events" class="px-2.5 py-1.5 rounded-md text-neutral-300 text-adaptive-muted hover:text-white hover:bg-radar-card transition hidden sm:inline-block">
        Events
      </a>

      <button type="button" id="navMapBtn" class="px-2.5 py-1.5 rounded-md text-neutral-300 text-adaptive-muted hover:text-white hover:bg-radar-card transition flex items-center gap-1">
        <span>🗺️</span>
        <span class="hidden sm:inline">Map</span>
      </button>

      <a href="/feed.xml" class="px-2.5 py-1.5 rounded-md text-neutral-300 text-adaptive-muted hover:text-white hover:bg-radar-card transition flex items-center gap-1" title="RSS 2.0 Feed">
        <svg class="w-3.5 h-3.5 text-kasavu-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 11a9 9 0 0 1 9 9"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1"></circle>
        </svg>
        <span class="hidden md:inline">RSS</span>
      </a>

      <a href="https://github.com/Midhunvvsggsg/hackradar-kerala/tree/main/data/manual.yaml" target="_blank" rel="noopener noreferrer" class="px-2.5 py-1.5 rounded-md text-kasavu-300 hover:text-kasavu-200 hover:bg-kasavu-950/30 transition flex items-center gap-1 border border-kasavu-500/20">
        <span>✏️</span>
        <span class="hidden md:inline">Submit Event</span>
      </a>

      <!-- Dark / Light Theme Toggle -->
      <button
        type="button"
        id="themeToggleBtn"
        class="w-9 h-9 rounded-lg flex items-center justify-center text-neutral-300 text-adaptive-muted hover:text-white hover:bg-radar-card border border-radar-border transition"
        title="Toggle dark/light theme"
        aria-label="Toggle dark and light color theme"
      >
        <!-- Sun icon (for dark mode) -->
        <svg class="w-4 h-4 dark-icon block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        <!-- Moon icon (for light mode) -->
        <svg class="w-4 h-4 light-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
      </button>

      <!-- GitHub Link -->
      <a
        href="https://github.com/Midhunvvsggsg/hackradar-kerala"
        target="_blank"
        rel="noopener noreferrer"
        class="w-9 h-9 rounded-lg flex items-center justify-center text-neutral-300 text-adaptive-muted hover:text-white hover:bg-radar-card border border-radar-border transition"
        title="GitHub repository"
        aria-label="View HackRadar Kerala on GitHub"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
    </div>
  </div>
</nav>

<script>
  // Theme Toggle Logic
  const themeToggleBtn = document.getElementById("themeToggleBtn");
  const darkIcon = themeToggleBtn?.querySelector(".dark-icon");
  const lightIcon = themeToggleBtn?.querySelector(".light-icon");

  // Check saved theme or system preference
  const isLight =
    localStorage.theme === "light" ||
    (!("theme" in localStorage) && window.matchMedia("(prefers-color-scheme: light)").matches);

  if (isLight) {
    document.documentElement.classList.add("light");
    document.body.classList.add("light");
    darkIcon?.classList.add("hidden");
    lightIcon?.classList.remove("hidden");
  }

  themeToggleBtn?.addEventListener("click", () => {
    const isCurrentlyLight = document.documentElement.classList.contains("light");
    if (isCurrentlyLight) {
      document.documentElement.classList.remove("light");
      document.body.classList.remove("light");
      localStorage.theme = "dark";
      darkIcon?.classList.remove("hidden");
      lightIcon?.classList.add("hidden");
    } else {
      document.documentElement.classList.add("light");
      document.body.classList.add("light");
      localStorage.theme = "light";
      darkIcon?.classList.add("hidden");
      lightIcon?.classList.remove("hidden");
    }
  });
</script>
