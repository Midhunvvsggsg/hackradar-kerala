      </button>

      <!-- Thrissur (Cultural Hub) -->
      <button
        type="button"
        class="radar-ping-btn absolute w-9 h-9 flex items-center justify-center p-0 top-[40%] left-[48%] -translate-x-1/2 -translate-y-1/2 group focus:outline-none"
        data-filter-city="thrissur"
        title="Filter by Thrissur Hackathons"
        aria-label="Filter Thrissur hackathons"
      >
        <span class="relative block w-2.5 h-2.5 rounded-full bg-coconut-400 border border-white shadow-[0_0_8px_#10b981] group-hover:scale-125 transition-transform"></span>
        <span class="absolute left-7 top-1/2 -translate-y-1/2 whitespace-nowrap text-[10px] font-mono font-bold text-white bg-neutral-950/95 px-2 py-0.5 rounded-md border border-coconut-500/40 shadow-lg opacity-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none z-20 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-xs bg-kasavu-400 shadow-[0_0_6px_#fbbf24]"></span>
          <span>Thrissur &bull; 2 events</span>
        </span>
      </button>

      <!-- Palakkad -->
      <button
        type="button"
        class="radar-ping-btn absolute w-9 h-9 flex items-center justify-center p-0 top-[36%] left-[62%] -translate-x-1/2 -translate-y-1/2 group focus:outline-none"
        data-filter-city="palakkad"
        title="Filter by Palakkad Hackathons"
        aria-label="Filter Palakkad hackathons"
      >
        <span class="relative block w-2.5 h-2.5 rounded-full bg-coconut-400 border border-white shadow-[0_0_8px_#10b981] group-hover:scale-125 transition-transform"></span>
        <span class="absolute left-7 top-1/2 -translate-y-1/2 whitespace-nowrap text-[10px] font-mono font-bold text-white bg-neutral-950/95 px-2 py-0.5 rounded-md border border-coconut-500/40 shadow-lg opacity-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none z-20 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-xs bg-kasavu-400 shadow-[0_0_6px_#fbbf24]"></span>
          <span>Palakkad &bull; 1 event</span>
        </span>
      </button>

      <!-- Kollam (South Kerala Hub) -->
      <button
        type="button"
        class="radar-ping-btn absolute w-9 h-9 flex items-center justify-center p-0 top-[64%] left-[50%] -translate-x-1/2 -translate-y-1/2 group focus:outline-none"
        data-filter-city="kollam"
        title="Filter by Kollam Hackathons"
        aria-label="Filter Kollam hackathons"
      >
        <span class="relative block w-2.5 h-2.5 rounded-full bg-coconut-400 border border-white shadow-[0_0_8px_#10b981] group-hover:scale-125 transition-transform"></span>
        <span class="absolute left-7 top-1/2 -translate-y-1/2 whitespace-nowrap text-[10px] font-mono font-bold text-white bg-neutral-950/95 px-2 py-0.5 rounded-md border border-coconut-500/40 shadow-lg opacity-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none z-20 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-xs bg-kasavu-400 shadow-[0_0_6px_#fbbf24]"></span>
          <span>Kollam &bull; 1 event</span>
        </span>
      </button>

      <div class="absolute bottom-3 text-[10px] font-mono text-coconut-400/70 uppercase tracking-widest bg-neutral-950/80 px-2 py-0.5 rounded border border-coconut-500/20">
        RADAR &bull; KL SECTOR
      </div>
    </div>
  </div>
</header>

<script>
  // =========================================================================
  // TUNABLE RADAR PIXEL FIELD CONFIGURATION
  // =========================================================================
  const CONFIG = {
    cellSize: 16,               // Cell size (pitch) in px (14-18px)
    pixelSize: 2.5,             // Base square pixel dimension (2-3px)
    baseOpacity: 0.10,          // Muted grid opacity (8-12%)
    cursorRadius: 140,          // Proximity interaction radius (px)
    maxScale: 2.2,              // Peak scale factor at core (1.0x - 2.2x)
    decayDuration: 750,         // Trail energy decay duration (ms)
    displacementStrength: 5.5,  // Max outward displacement (px)
    springStiffness: 0.14,      // Spring stiffness coefficient
    springDamping: 0.82,        // Spring damping coefficient
    lerpFactor: 0.18,           // Cursor smoothing lerp factor
    rippleSpeed: 300,           // Ping ripple propagation speed (px/s)
    rippleMaxRadius: 300,       // Max radius for click/tap ripple (px)
    rippleThickness: 34,        // Thickness of ripple ring band (px)
    ambientWaveSpeed: 0.0016,   // Idle state wave oscillation frequency
    ambientWaveFreq: 0.008,     // Idle spatial wave frequency
    ambientIntensity: 0.09,     // Idle wave amplitude
    radarSweepPeriod: 4000,     // Radar sweep beam cycle duration (ms)
    radarSweepAngleWidth: 0.22, // Angular flash sector width (radians)
    radarSweepMaxDist: 600,     // Max distance for sweep synchronization (px)
    energyThreshold: 0.006,     // Minimum energy to activate scale & color blend
  };

  interface RGB {
    r: number;
    g: number;
    b: number;
  }

  interface Cell {
    x0: number;
    y0: number;
    x: number;
    y: number;
    vx: number;
    vy: number;
    energy: number;
    mask: number;
    radarDist: number;
    radarAngle: number;
  }

  interface Ripple {
    x: number;
    y: number;
    radius: number;
    maxRadius: number;
    birth: number;
  }

  function parseCssColor(str: string, fallback: RGB): RGB {
    const s = str.trim();
    if (s.startsWith("#")) {
      let hex = s.slice(1);
      if (hex.length === 3) {
        hex = hex.split("").map((c) => c + c).join("");
      }
      if (hex.length >= 6) {
        const num = parseInt(hex.slice(0, 6), 16);
        return {
          r: (num >> 16) & 255,
          g: (num >> 8) & 255,
          b: num & 255,
        };
      }
    } else if (s.startsWith("rgb")) {
      const m = s.match(/\d+(\.\d+)?/g);
      if (m && m.length >= 3) {
        return {
          r: parseFloat(m[0]),
          g: parseFloat(m[1]),
          b: parseFloat(m[2]),
        };
      }
    }
    return fallback;
  }

  function lerp(a: number, b: number, t: number): number {
    return a + (b - a) * t;
  }

  function interpolateRgb(c1: RGB, c2: RGB, t: number): RGB {
    const clampedT = Math.max(0, Math.min(1, t));
    return {
      r: Math.round(lerp(c1.r, c2.r, clampedT)),
      g: Math.round(lerp(c1.g, c2.g, clampedT)),
      b: Math.round(lerp(c1.b, c2.b, clampedT)),
    };
  }

  function initPixelField() {
    const heroEl = document.getElementById("radarHero");
    const canvas = document.getElementById("heroPixelCanvas") as HTMLCanvasElement | null;
    if (!heroEl || !canvas) return;

    const ctx = canvas.getContext("2d", { alpha: true });
    if (!ctx) return;

    let cells: Cell[] = [];
    const ripples: Ripple[] = [];
    let width = 0;
    let height = 0;
    let dpr = 1;
    let rafId: number | null = null;
    let lastTime = performance.now();

    const targetCursor = { x: -9999, y: -9999, active: false };
    const smoothCursor = { x: -9999, y: -9999 };

    let colorBase: RGB = { r: 20, g: 184, b: 166 };
    let colorHot: RGB = { r: 52, g: 211, b: 153 };
    let colorGold: RGB = { r: 251, g: 191, b: 36 };

    function refreshThemeColors() {
      const styles = getComputedStyle(document.documentElement);
      colorBase = parseCssColor(styles.getPropertyValue("--pixel-base"), { r: 20, g: 184, b: 166 });
      colorHot = parseCssColor(styles.getPropertyValue("--pixel-hot"), { r: 52, g: 211, b: 153 });
      colorGold = parseCssColor(styles.getPropertyValue("--pixel-gold"), { r: 251, g: 191, b: 36 });
    }

    refreshThemeColors();

    const themeObserver = new MutationObserver(() => {
      refreshThemeColors();
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
    themeObserver.observe(document.body, { attributes: true, attributeFilter: ["class"] });

    const radarEl = document.getElementById("heroRadarContainer");
    let radarCenterX = -1000;
    let radarCenterY = -1000;
    let hasRadar = false;

    function updateRadarCenter() {
      if (radarEl && radarEl.offsetParent !== null) {
        const heroR = heroEl!.getBoundingClientRect();
        const radarR = radarEl.getBoundingClientRect();
        radarCenterX = radarR.left + radarR.width / 2 - heroR.left;
        radarCenterY = radarR.top + radarR.height / 2 - heroR.top;
        hasRadar = true;
      } else {
        hasRadar = false;
      }
    }

    function buildGrid() {
      const rect = heroEl!.getBoundingClientRect();
      width = Math.floor(rect.width);
      height = Math.floor(rect.height);
      dpr = Math.min(window.devicePixelRatio || 1, 2);

      canvas!.width = Math.floor(width * dpr);
      canvas!.height = Math.floor(height * dpr);
      canvas!.style.width = `${width}px`;
      canvas!.style.height = `${height}px`;

      updateRadarCenter();

      cells = [];
      const cols = Math.ceil(width / CONFIG.cellSize);
      const rows = Math.ceil(height / CONFIG.cellSize);

      for (let r = 0; r < rows; r++) {
        const y0 = r * CONFIG.cellSize + CONFIG.cellSize / 2;
        for (let c = 0; c < cols; c++) {
          const x0 = c * CONFIG.cellSize + CONFIG.cellSize / 2;

          // 1. Edge falloff (fade out near boundaries)
          const edgeFadeX = Math.min(x0 / 40, (width - x0) / 40, 1);
          const edgeFadeY = Math.min(y0 / 30, (height - y0) / 30, 1);
          const edgeMask = Math.max(0, edgeFadeX * edgeFadeY);

          // 2. Zone masking (concentrate in middle, fade under headline text to maintain WCAG AA contrast)
          let zoneFactor = 1.0;
          if (width >= 768) {
            const normX = x0 / width;
            if (normX < 0.36) {
              zoneFactor = Math.pow(Math.max(0, (normX - 0.10) / 0.26), 2);
            } else if (normX <= 0.74) {
              zoneFactor = 1.0;
            } else {
              zoneFactor = Math.max(0.25, 1 - (normX - 0.74) / 0.26);
            }
          } else {
            const cx = width * 0.5;
            const cy = height * 0.52;
            const dx = (x0 - cx) / (width * 0.5);
            const dy = (y0 - cy) / (height * 0.48);
            zoneFactor = Math.max(0, 1 - Math.sqrt(dx * dx + dy * dy));
            if (y0 < 160) {
              zoneFactor *= Math.max(0, (y0 - 30) / 130);
            }
          }

          const mask = Math.max(0, Math.min(1, edgeMask * zoneFactor));

          // Prune negligible cells for high performance
          if (mask < 0.015) continue;

          let rDist = 9999;
          let rAngle = 0;
          if (hasRadar) {
            rDist = Math.hypot(x0 - radarCenterX, y0 - radarCenterY);
            rAngle = Math.atan2(y0 - radarCenterY, x0 - radarCenterX);
          }

          cells.push({
            x0,
            y0,
            x: x0,
            y: y0,
            vx: 0,
            vy: 0,
            energy: 0,
            mask,
            radarDist: rDist,
            radarAngle: rAngle,
          });
        }
      }
    }

    buildGrid();

    // Debounced Resize
    let resizeTimer: number | null = null;
    window.addEventListener("resize", () => {
      if (resizeTimer) clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        buildGrid();
        if (prefersReducedMotion) {
          drawStaticGrid();
        }
      }, 150);
    });

    // Pointer events on hero container (mouse, pen, touch)
    heroEl.addEventListener("pointerenter", (e) => {
      const rect = heroEl!.getBoundingClientRect();
      targetCursor.x = e.clientX - rect.left;
      targetCursor.y = e.clientY - rect.top;
      targetCursor.active = true;
    });

    heroEl.addEventListener("pointermove", (e) => {
      const rect = heroEl!.getBoundingClientRect();
      targetCursor.x = e.clientX - rect.left;
      targetCursor.y = e.clientY - rect.top;
      targetCursor.active = true;
    });

    heroEl.addEventListener("pointerleave", () => {
      targetCursor.active = false;
    });

    heroEl.addEventListener("pointerdown", (e) => {
      const rect = heroEl!.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const clickY = e.clientY - rect.top;
      ripples.push({
        x: clickX,
        y: clickY,
        radius: 0,
        maxRadius: CONFIG.rippleMaxRadius,
        birth: performance.now(),
      });
    });

    // Automated interactive sequence when ?demo=active (ideal for screenshots & test verification)
    if (window.location.search.includes("demo=active")) {
      setTimeout(() => {
        let step = 0;
        const interval = setInterval(() => {
          step++;
          const rect = heroEl!.getBoundingClientRect();
          const targetX = rect.width * 0.54 + Math.sin(step * 0.18) * 110;
          const targetY = rect.height * 0.46 + Math.cos(step * 0.18) * 35;
          targetCursor.x = targetX;
          targetCursor.y = targetY;
          targetCursor.active = true;

          if (step === 15) {
            ripples.push({
              x: targetX,
              y: targetY,
              radius: 0,
              maxRadius: CONFIG.rippleMaxRadius,
              birth: performance.now(),
            });
          }
          if (step > 40) {
            clearInterval(interval);
          }
        }, 25);
      }, 100);
    }

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function drawStaticGrid() {
      if (!ctx) return;
      ctx.clearRect(0, 0, canvas!.width, canvas!.height);
      ctx.save();
      ctx.scale(dpr, dpr);
      for (let i = 0; i < cells.length; i++) {
        const c = cells[i];
        const alpha = CONFIG.baseOpacity * c.mask;
        if (alpha < 0.005) continue;
        ctx.fillStyle = `rgba(${colorBase.r}, ${colorBase.g}, ${colorBase.b}, ${alpha.toFixed(3)})`;
        ctx.fillRect(
          c.x0 - CONFIG.pixelSize / 2,
          c.y0 - CONFIG.pixelSize / 2,
          CONFIG.pixelSize,
          CONFIG.pixelSize
        );
      }
      ctx.restore();
    }

    if (prefersReducedMotion) {
      drawStaticGrid();
      return;
    }

    let isVisible = true;
    let isTabActive = !document.hidden;
    let isLoopRunning = false;

    function frame(now: number) {
      if (!isLoopRunning) return;
      const dt = Math.min(now - lastTime, 64);
      lastTime = now;

      // 1. Lerp cursor smoothing
      if (targetCursor.active) {
        smoothCursor.x += (targetCursor.x - smoothCursor.x) * CONFIG.lerpFactor;
        smoothCursor.y += (targetCursor.y - smoothCursor.y) * CONFIG.lerpFactor;
      } else {
        smoothCursor.x += (-9999 - smoothCursor.x) * 0.1;
      }

      // 2. Expand ripples
      for (let rIdx = ripples.length - 1; rIdx >= 0; rIdx--) {
        const rip = ripples[rIdx];
        rip.radius += (CONFIG.rippleSpeed * dt) / 1000;
        if (rip.radius >= rip.maxRadius) {
          ripples.splice(rIdx, 1);
          continue;
        }
        const life = 1 - rip.radius / rip.maxRadius;
        for (let i = 0; i < cells.length; i++) {
          const c = cells[i];
          const cd = Math.hypot(c.x - rip.x, c.y - rip.y);
          const band = Math.abs(cd - rip.radius);
          if (band < CONFIG.rippleThickness) {
            const p = (1 - band / CONFIG.rippleThickness) * life * 0.95;
            c.energy = Math.max(c.energy, p);
            if (cd > 2) {
              const ang = Math.atan2(c.y - rip.y, c.x - rip.x);
              c.vx += Math.cos(ang) * p * 1.4;
              c.vy += Math.sin(ang) * p * 1.4;
            }
          }
        }
      }

      // 3. Radar sweep angle sync (matches 4s beam)
      const sweepAngle = ((now % CONFIG.radarSweepPeriod) / CONFIG.radarSweepPeriod) * Math.PI * 2 - Math.PI / 2;

      // 4. Update and render cells
      ctx!.clearRect(0, 0, canvas!.width, canvas!.height);
      ctx!.save();
      ctx!.scale(dpr, dpr);

      const decayStep = dt / CONFIG.decayDuration;

      for (let i = 0; i < cells.length; i++) {
        const c = cells[i];

        // A. Trail energy decay over 600-900ms
        c.energy = Math.max(0, c.energy - decayStep);

        // B. Cursor proximity interaction
        if (targetCursor.active) {
          const distToCursor = Math.hypot(c.x0 - smoothCursor.x, c.y0 - smoothCursor.y);
          if (distToCursor < CONFIG.cursorRadius) {
            const normD = distToCursor / CONFIG.cursorRadius;
            const proxEnergy = Math.pow(1 - normD, 1.4);
            c.energy = Math.max(c.energy, proxEnergy);

            // Subtle outward push displacement
            if (distToCursor > 2) {
              const push = (1 - normD) * CONFIG.displacementStrength;
              const ang = Math.atan2(c.y0 - smoothCursor.y, c.x0 - smoothCursor.x);
              const targetX = c.x0 + Math.cos(ang) * push;
              const targetY = c.y0 + Math.sin(ang) * push;
              const ax = (targetX - c.x) * CONFIG.springStiffness;
              const ay = (targetY - c.y) * CONFIG.springStiffness;
              c.vx = (c.vx + ax) * CONFIG.springDamping;
              c.vy = (c.vy + ay) * CONFIG.springDamping;
              c.x += c.vx;
              c.y += c.vy;
            }
          }
        }

        // C. Radar sweep flash sync in middle region
        if (hasRadar && c.radarDist > 140 && c.radarDist < CONFIG.radarSweepMaxDist) {
          let diff = (c.radarAngle - sweepAngle) % (Math.PI * 2);
          if (diff < -Math.PI) diff += Math.PI * 2;
          if (diff > Math.PI) diff -= Math.PI * 2;
          if (diff >= -0.04 && diff <= CONFIG.radarSweepAngleWidth) {
            const sweepPower =
              (1 - diff / CONFIG.radarSweepAngleWidth) *
              (1 - c.radarDist / CONFIG.radarSweepMaxDist) *
              0.48 *
              c.mask;
            c.energy = Math.max(c.energy, sweepPower);
          }
        }

        // D. Spring return physics (simple Euler spring, no library)
        const ax = (c.x0 - c.x) * CONFIG.springStiffness;
        const ay = (c.y0 - c.y) * CONFIG.springStiffness;
        c.vx = (c.vx + ax) * CONFIG.springDamping;
        c.vy = (c.vy + ay) * CONFIG.springDamping;
        c.x += c.vx;
        c.y += c.vy;
        if (Math.abs(c.x - c.x0) < 0.05 && Math.abs(c.vx) < 0.02) {
          c.x = c.x0;
          c.vx = 0;
          c.y = c.y0;
          c.vy = 0;
        }

        // E. Idle state ambient wave
        let idleBright = 0;
        if (!targetCursor.active) {
          const wave = Math.sin(c.x0 * CONFIG.ambientWaveFreq + c.y0 * 0.005 + now * CONFIG.ambientWaveSpeed);
          idleBright = (wave * 0.5 + 0.5) * CONFIG.ambientIntensity * c.mask;
        }

        const totalEnergy = Math.min(1, c.energy + idleBright);
        const effectiveAlpha = (CONFIG.baseOpacity + totalEnergy * (1 - CONFIG.baseOpacity)) * c.mask;
        if (effectiveAlpha < 0.006) continue;

        // F. Color interpolation: Backwater Teal -> Coconut Green -> Kasavu Gold at cursor core
        let r: number, g: number, b: number;
        if (totalEnergy < 0.55) {
          const t = totalEnergy / 0.55;
          const col = interpolateRgb(colorBase, colorHot, t);
          r = col.r;
          g = col.g;
          b = col.b;
        } else {
          const t = (totalEnergy - 0.55) / 0.45;
          const col = interpolateRgb(colorHot, colorGold, t);
          r = col.r;
          g = col.g;
          b = col.b;
        }

        // G. Dynamic scaling: 1x to 2.2x
        const scale = 1 + (CONFIG.maxScale - 1) * Math.pow(totalEnergy, 1.3);
        const pSize = CONFIG.pixelSize * scale;

        ctx!.fillStyle = `rgba(${r}, ${g}, ${b}, ${effectiveAlpha.toFixed(3)})`;
        ctx!.fillRect(c.x - pSize / 2, c.y - pSize / 2, pSize, pSize);
      }

      ctx!.restore();
      rafId = requestAnimationFrame(frame);
    }

    function startLoop() {
      if (!isLoopRunning) {
        isLoopRunning = true;
        lastTime = performance.now();
        rafId = requestAnimationFrame(frame);
      }
    }

    function stopLoop() {
      if (isLoopRunning) {
        isLoopRunning = false;
        if (rafId) cancelAnimationFrame(rafId);
        rafId = null;
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        isVisible = entries[0]?.isIntersecting ?? true;
        if (isVisible && isTabActive) {
          startLoop();
        } else {
          stopLoop();
        }
      },
      { threshold: 0.05 }
    );
    observer.observe(heroEl);

    document.addEventListener("visibilitychange", () => {
      isTabActive = !document.hidden;
      if (isVisible && isTabActive) {
        startLoop();
      } else {
        stopLoop();
      }
    });

    startLoop();

    // Ping Burst Particle Spawner & ripple injection on radar ping buttons
    function spawnPingBurst(buttonEl: HTMLElement) {
      const count = 8;
      for (let i = 0; i < count; i++) {
        const p = document.createElement("span");
        p.className = "ping-burst-particle";
        const angle = (i / count) * Math.PI * 2 + (Math.random() - 0.5) * 0.4;
        const dist = 18 + Math.random() * 12;
        p.style.setProperty("--burst-dx", `${(Math.cos(angle) * dist).toFixed(1)}px`);
        p.style.setProperty("--burst-dy", `${(Math.sin(angle) * dist).toFixed(1)}px`);
        p.style.left = "50%";
        p.style.top = "50%";
        buttonEl.appendChild(p);
        setTimeout(() => p.remove(), 450);
      }
    }

    document.querySelectorAll<HTMLElement>(".radar-ping-btn").forEach((btn) => {
      btn.addEventListener("pointerenter", () => {
        spawnPingBurst(btn);
        const heroR = heroEl!.getBoundingClientRect();
        const btnR = btn.getBoundingClientRect();
        ripples.push({
          x: btnR.left + btnR.width / 2 - heroR.left,
          y: btnR.top + btnR.height / 2 - heroR.top,
          radius: 0,
          maxRadius: 180,
          birth: performance.now(),
        });
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPixelField);
  } else {
    initPixelField();
  }
</script>
