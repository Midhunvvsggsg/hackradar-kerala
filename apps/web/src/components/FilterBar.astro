---
interface Props {
  cities: string[];
  themes: string[];
}
const { cities, themes } = Astro.props;
---

<div class="sticky top-0 z-30 bg-radar-bg/90 bg-radar-nav backdrop-blur-md border-b border-radar-border py-3 mb-6 transition-colors" id="stickyFilterBar">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 space-y-3">
    <!-- Top Row: Full-width Search Bar + Mobile Filter Drawer Toggle + Desktop Quick Controls -->
    <div class="flex items-center gap-3">
      <!-- Full-width Search Bar -->
      <div class="relative flex-1">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-neutral-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
        <input
          type="search"
          id="searchInput"
          placeholder="Search hackathons, cities, tech"
          class="w-full pl-9 pr-10 py-2 rounded-lg bg-radar-card border border-radar-border text-sm text-white placeholder-neutral-500 focus:outline-none focus:border-coconut-500 focus:ring-1 focus:ring-coconut-500 transition"
        />
        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
          <kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] font-mono text-neutral-400 bg-neutral-800 border border-neutral-700 rounded shadow-sm">/</kbd>
        </div>
      </div>

      <!-- Mobile Filters Trigger Button (< md) -->
      <button
        type="button"
        id="mobileFilterToggleBtn"
        class="md:hidden inline-flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-mono font-medium bg-radar-card border border-radar-border text-neutral-300 hover:border-neutral-500 transition"
        aria-label="Open filter options"
      >
        <svg class="w-4 h-4 text-coconut-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
        <span>Filters</span>
        <span id="mobileFilterBadge" class="hidden w-4 h-4 rounded-full bg-coconut-500 text-neutral-900 text-[10px] font-bold items-center justify-center">0</span>
      </button>

      <!-- Desktop Sort Selector -->
      <div class="hidden md:flex items-center gap-2">
        <label for="sortSelector" class="text-xs font-mono text-neutral-400 hidden lg:inline-block">Sort:</label>
        <select
          id="sortSelector"
          class="bg-radar-card border border-radar-border text-xs rounded-lg px-2.5 py-2 text-neutral-300 focus:outline-none focus:border-coconut-500 font-mono transition"
        >
          <option value="closing">Closing soonest</option>
          <option value="newest">Newest added</option>
          <option value="prize">Prize high to low</option>
        </select>
      </div>
    </div>

    <!-- Desktop Filter Toolbar (Hidden on small mobile, visible >= md) -->
    <div class="hidden md:flex flex-wrap items-center justify-between gap-3 pt-1 border-t border-radar-border/40">
      <div class="flex flex-wrap items-center gap-3">
        <!-- Fee Segmented Control -->
        <div class="inline-flex rounded-lg bg-radar-card border border-radar-border p-0.5 text-xs font-mono" id="feeSelector">
          <button type="button" data-val="all" class="fee-btn px-2.5 py-1 rounded bg-coconut-600 text-white font-medium transition">All</button>
          <button type="button" data-val="free" class="fee-btn px-2.5 py-1 rounded text-neutral-400 hover:text-white transition">Free</button>
          <button type="button" data-val="paid" class="fee-btn px-2.5 py-1 rounded text-neutral-400 hover:text-white transition">Paid</button>
        </div>

        <!-- Mode Segmented Control -->
        <div class="inline-flex rounded-lg bg-radar-card border border-radar-border p-0.5 text-xs font-mono" id="modeSelector">
          <button type="button" data-val="all" class="mode-btn px-2.5 py-1 rounded bg-coconut-600 text-white font-medium transition">All</button>
          <button type="button" data-val="online" class="mode-btn px-2.5 py-1 rounded text-neutral-400 hover:text-white transition">Online</button>
          <button type="button" data-val="offline" class="mode-btn px-2.5 py-1 rounded text-neutral-400 hover:text-white transition">Offline</button>
          <button type="button" data-val="hybrid" class="mode-btn px-2.5 py-1 rounded text-neutral-400 hover:text-white transition">Hybrid</button>
        </div>

        <!-- Theme Toggle Button -->
        <button
          type="button"
          id="themeToggleCollapseBtn"
          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-mono text-neutral-400 hover:text-white bg-radar-card border border-radar-border hover:border-neutral-600 transition"
        >
          <span>Themes</span>
          <svg class="w-3 h-3 transform transition-transform duration-200" id="themeArrowIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>
      </div>

      <!-- Styled Custom Switch for Nearby Hubs -->
      <label class="inline-flex items-center gap-2 text-xs font-mono text-neutral-300 cursor-pointer select-none">
        <span class="text-neutral-400">Include nearby hubs</span>
        <div class="relative inline-block w-8 h-4 align-middle select-none transition duration-200 ease-in">
          <input type="checkbox" id="nearbyToggle" class="toggle-checkbox absolute block w-4 h-4 rounded-full bg-neutral-400 border-2 border-neutral-800 appearance-none cursor-pointer transition-transform duration-200 checked:translate-x-4 checked:bg-coconut-400" />
          <div class="toggle-label block overflow-hidden h-4 rounded-full bg-neutral-800 border border-radar-border"></div>
        </div>
      </label>
    </div>

    <!-- Horizontally Scrollable City Chips Row -->
    <div class="relative flex items-center pt-1 overflow-hidden">
      <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar scroll-smooth py-1 w-full" id="cityChipsContainer">
        <button
          type="button"
          data-city=""
          class="city-chip flex-shrink-0 px-3 py-1 rounded-full text-xs font-mono font-medium bg-coconut-600 text-white transition shadow-sm"
        >
          All Kerala
        </button>
        {cities.map((city) => (
          <button
            type="button"
            data-city={city.toLowerCase()}
            class="city-chip flex-shrink-0 px-3 py-1 rounded-full text-xs font-mono text-neutral-400 bg-radar-card border border-radar-border hover:text-white hover:border-neutral-500 transition"
          >
            {city}
          </button>
        ))}
      </div>
    </div>

    <!-- Collapsible Multi-Select Theme/Tech Row -->
    <div id="themeChipsRow" class="hidden pt-2 border-t border-radar-border/40 flex-wrap gap-1.5 transition-all">
      <span class="text-[11px] font-mono text-neutral-500 self-center mr-1">Filter by Tech:</span>
      {themes.map((theme) => (
        <button
          type="button"
          data-theme={theme.toLowerCase()}
          class="theme-chip px-2 py-0.5 rounded text-[11px] font-mono bg-neutral-900 text-neutral-400 border border-neutral-800 hover:border-coconut-500 hover:text-neutral-200 transition"
        >
          #{theme}
        </button>
      ))}
    </div>

    <!-- Active Filter Chips Row & Results Count -->
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-neutral-400 pt-1">
      <div class="flex flex-wrap items-center gap-2">
        <div id="resultsCount" class="font-mono font-medium text-neutral-300" aria-live="polite">
          Loading hackathons...
        </div>

        <div id="activeFilterChips" class="flex flex-wrap items-center gap-1.5"></div>
      </div>

      <button id="resetFiltersBtn" class="text-xs font-mono text-neutral-400 hover:text-coconut-400 transition underline underline-offset-2 hidden">
        Reset all
      </button>
    </div>
  </div>
</div>

<!-- Mobile Filter Bottom Sheet / Drawer -->
<div id="mobileFilterDrawer" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm hidden flex flex-col justify-end transition-opacity" role="dialog" aria-modal="true" aria-labelledby="mobileFilterTitle">
  <div class="bg-radar-surface border-t border-radar-border rounded-t-2xl p-6 max-h-[85vh] overflow-y-auto space-y-6 animate-slide-up shadow-2xl">
    <div class="flex items-center justify-between border-b border-radar-border pb-3">
      <h2 id="mobileFilterTitle" class="text-base font-bold text-white text-adaptive-title font-mono flex items-center gap-2">
        <span>Filter Hackathons</span>
      </h2>
      <button type="button" id="closeMobileFilterBtn" class="p-1 min-w-[36px] min-h-[36px] flex items-center justify-center rounded text-neutral-400 hover:text-white" aria-label="Close filters">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <!-- Mobile Sort -->
    <div class="space-y-2">
      <label class="text-xs font-mono text-neutral-400 uppercase tracking-wider">Sort by</label>
      <select id="mobileSortSelector" class="w-full bg-radar-card border border-radar-border text-sm rounded-lg p-2.5 text-white font-mono">
        <option value="closing">Closing soonest</option>
        <option value="newest">Newest added</option>
        <option value="prize">Prize high to low</option>
      </select>
    </div>

    <!-- Mobile Fee -->
    <div class="space-y-2">
      <label class="text-xs font-mono text-neutral-400 uppercase tracking-wider">Registration Fee</label>
      <div class="grid grid-cols-3 gap-2 font-mono text-xs" id="mobileFeeSelector">
        <button type="button" data-val="all" class="m-fee-btn py-2 rounded-lg bg-coconut-600 text-white font-medium">All</button>
        <button type="button" data-val="free" class="m-fee-btn py-2 rounded-lg bg-radar-card border border-radar-border text-neutral-400">Free</button>
        <button type="button" data-val="paid" class="m-fee-btn py-2 rounded-lg bg-radar-card border border-radar-border text-neutral-400">Paid</button>
      </div>
    </div>

    <!-- Mobile Mode -->
    <div class="space-y-2">
      <label class="text-xs font-mono text-neutral-400 uppercase tracking-wider">Event Mode</label>
      <div class="grid grid-cols-4 gap-1.5 font-mono text-xs" id="mobileModeSelector">
        <button type="button" data-val="all" class="m-mode-btn py-2 rounded-lg bg-coconut-600 text-white font-medium">All</button>
        <button type="button" data-val="online" class="m-mode-btn py-2 rounded-lg bg-radar-card border border-radar-border text-neutral-400">Online</button>
        <button type="button" data-val="offline" class="m-mode-btn py-2 rounded-lg bg-radar-card border border-radar-border text-neutral-400">Offline</button>
        <button type="button" data-val="hybrid" class="m-mode-btn py-2 rounded-lg bg-radar-card border border-radar-border text-neutral-400">Hybrid</button>
      </div>
    </div>

    <!-- Mobile Nearby Toggle -->
    <div class="pt-2 border-t border-radar-border">
      <label class="flex items-center justify-between text-sm font-mono text-neutral-200 cursor-pointer">
        <span>Include nearby hubs (Bengaluru, etc.)</span>
        <input type="checkbox" id="mobileNearbyToggle" class="w-4 h-4 rounded text-coconut-500 focus:ring-0 bg-neutral-900 border-radar-border" />
      </label>
    </div>

    <!-- Mobile Actions -->
    <div class="pt-4 flex gap-3">
      <button type="button" id="mobileResetBtn" class="flex-1 py-2.5 rounded-lg text-xs font-mono bg-neutral-800 text-neutral-300 border border-neutral-700">
        Reset All
      </button>
      <button type="button" id="mobileApplyBtn" class="flex-1 py-2.5 rounded-lg text-xs font-mono font-bold bg-coconut-600 hover:bg-coconut-500 text-white">
        Apply Filters
      </button>
    </div>
  </div>
</div>
