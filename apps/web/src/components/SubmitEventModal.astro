---
---

<!-- Submit Hackathon Modal Dialog -->
<div
  id="submitEventModal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-3 sm:p-4 bg-black/75 backdrop-blur-sm transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="submitModalTitle"
>
  <div
    class="relative w-full max-w-lg max-h-[92vh] overflow-y-auto rounded-2xl bg-radar-card border border-radar-border shadow-2xl p-5 sm:p-6 text-neutral-100 transition-transform duration-200 scale-95"
    id="submitModalCard"
  >
    <!-- Modal Close Button -->
    <button
      type="button"
      id="closeSubmitModalBtn"
      class="absolute top-4 right-4 w-8 h-8 rounded-lg flex items-center justify-center text-neutral-400 hover:text-white hover:bg-neutral-800 transition focus:outline-none focus:ring-2 focus:ring-coconut-500"
      aria-label="Close modal"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>

    <!-- Modal Header -->
    <div class="space-y-1.5 pr-8 pb-4 border-b border-radar-border">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono bg-kasavu-500/15 text-kasavu-300 border border-kasavu-500/30">
        <span class="w-1.5 h-1.5 rounded-full bg-kasavu-400 animate-pulse"></span>
        <span>SUBMIT HACKATHON</span>
      </div>
      <h3 id="submitModalTitle" class="text-xl font-bold font-display text-white text-adaptive-title tracking-tight">
        Add an Event to HackRadar
      </h3>
      <p class="text-xs text-neutral-300 text-adaptive-muted leading-relaxed">
        Details will be emailed directly to <strong class="text-coconut-400 font-mono">midhunv800@gmail.com</strong> for quick review and inclusion.
      </p>
    </div>

    <!-- Submission Form -->
    <form id="submitEventForm" class="space-y-3.5 pt-4 text-xs font-mono">
      <!-- Title -->
      <div>
        <label for="eventTitle" class="block text-neutral-300 text-adaptive-title font-semibold mb-1">
          Hackathon Title <span class="text-red-400">*</span>
        </label>
        <input
          type="text"
          id="eventTitle"
          required
          placeholder="e.g. BeachHack 2026, TinkerSpace Build"
          class="w-full px-3 py-2 rounded-lg bg-neutral-900 border border-radar-border text-white placeholder-neutral-500 focus:outline-none focus:border-coconut-500 text-xs transition"
        />
      </div>

      <!-- Organizer & Website -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label for="eventOrganizer" class="block text-neutral-300 text-adaptive-title font-semibold mb-1">
            Organizer / College <span class="text-red-400">*</span>
          </label>
          <input
            type="text"
            id="eventOrganizer"
            required
            placeholder="e.g. CUSAT, TinkerHub, GDG"
            class="w-full px-3 py-2 rounded-lg bg-neutral-900 border border-radar-border text-white placeholder-neutral-500 focus:outline-none focus:border-coconut-500 text-xs transition"
          />
        </div>
        <div>
          <label for="eventUrl" class="block text-neutral-300 text-adaptive-title font-semibold mb-1">
            Website / Link <span class="text-red-400">*</span>
          </label>
          <input
            type="url"
            id="eventUrl"
            required
            placeholder="https://..."
            class="w-full px-3 py-2 rounded-lg bg-neutral-900 border border-radar-border text-white placeholder-neutral-500 focus:outline-none focus:border-coconut-500 text-xs transition"
          />
        </div>
      </div>

      <!-- Mode & City -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label for="eventMode" class="block text-neutral-300 text-adaptive-title font-semibold mb-1">
            Mode
          </label>
          <select
            id="eventMode"
            class="w-full px-3 py-2 rounded-lg bg-neutral-900 border border-radar-border text-white focus:outline-none focus:border-coconut-500 text-xs transition"
          >
            <option value="offline">In-Person (Offline)</option>
            <option value="online">Online / Virtual</option>
            <option value="hybrid">Hybrid</option>
          </select>
        </div>
        <div>
          <label for="eventCity" class="block text-neutral-300 text-adaptive-title font-semibold mb-1">
            City / Venue
          </label>
          <input
            type="text"
            id="eventCity"
            placeholder="Kochi, Trivandrum, Kozhikode..."
            class="w-full px-3 py-2 rounded-lg bg-neutral-900 border border-radar-border text-white placeholder-neutral-500 focus:outline-none focus:border-coconut-500 text-xs transition"
          />
        </div>
      </div>

      <!-- Dates & Registration Deadline -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label for="eventDeadline" class="block text-neutral-300 text-adaptive-title font-semibold mb-1">
            Registration Deadline
          </label>
          <input
            type="date"
            id="eventDeadline"
            class="w-full px-3 py-2 rounded-lg bg-neutral-900 border border-radar-border text-white focus:outline-none focus:border-coconut-500 text-xs transition"
          />
        </div>
        <div>
          <label for="eventStartDate" class="block text-neutral-300 text-adaptive-title font-semibold mb-1">
            Event Date
          </label>
          <input
            type="date"
            id="eventStartDate"
            class="w-full px-3 py-2 rounded-lg bg-neutral-900 border border-radar-border text-white focus:outline-none focus:border-coconut-500 text-xs transition"
          />
        </div>
      </div>

      <!-- Fee & Prizes -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label for="eventFee" class="block text-neutral-300 text-adaptive-title font-semibold mb-1">
            Entry Fee
          </label>
          <input
            type="text"
            id="eventFee"
            placeholder="Free or ₹300 / team"
            class="w-full px-3 py-2 rounded-lg bg-neutral-900 border border-radar-border text-white placeholder-neutral-500 focus:outline-none focus:border-coconut-500 text-xs transition"
          />
        </div>
        <div>
          <label for="eventPrize" class="block text-neutral-300 text-adaptive-title font-semibold mb-1">
            Prize Pool (Optional)
          </label>
          <input
            type="text"
            id="eventPrize"
            placeholder="e.g. ₹50,000, Swag"
            class="w-full px-3 py-2 rounded-lg bg-neutral-900 border border-radar-border text-white placeholder-neutral-500 focus:outline-none focus:border-coconut-500 text-xs transition"
          />
        </div>
      </div>

      <!-- Organizer Contact / Additional Notes -->
      <div>
        <label for="eventNotes" class="block text-neutral-300 text-adaptive-title font-semibold mb-1">
          Your Contact / Additional Info
        </label>
        <textarea
          id="eventNotes"
          rows="2"
          placeholder="Organizer email, phone, Discord/WhatsApp link, or eligibility notes..."
          class="w-full px-3 py-2 rounded-lg bg-neutral-900 border border-radar-border text-white placeholder-neutral-500 focus:outline-none focus:border-coconut-500 text-xs transition resize-none"
        ></textarea>
      </div>

      <!-- Action Buttons -->
      <div class="pt-3 space-y-2">
        <div class="flex flex-col sm:flex-row items-center gap-2">
          <!-- Primary: Open in Gmail Web Compose -->
          <button
            type="button"
            id="sendGmailBtn"
            class="w-full sm:flex-1 py-2.5 px-4 rounded-lg text-xs font-semibold bg-red-600 hover:bg-red-500 text-white transition flex items-center justify-center gap-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-red-400"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L5.455 4.64 12 9.548l6.545-4.91 1.528-1.145C21.69 2.28 24 3.434 24 5.457z"/>
            </svg>
            <span>Open & Send in Gmail</span>
          </button>

          <!-- Secondary: Default mailto client -->
          <button
            type="button"
            id="sendMailtoBtn"
            class="w-full sm:w-auto py-2.5 px-3.5 rounded-lg text-xs font-medium bg-backwater-700 hover:bg-backwater-600 text-white transition flex items-center justify-center gap-1.5 focus:outline-none focus:ring-2 focus:ring-backwater-400"
            title="Send using default email client"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <span>Mail App</span>
          </button>

          <!-- Copy formatted text -->
          <button
            type="button"
            id="copyDetailsBtn"
            class="w-full sm:w-auto py-2.5 px-3 rounded-lg text-xs font-medium bg-neutral-800 hover:bg-neutral-700 text-neutral-200 transition border border-radar-border flex items-center justify-center gap-1"
            title="Copy details to clipboard"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
            <span>Copy</span>
          </button>
        </div>

        <div class="text-[10px] text-center text-neutral-400 text-adaptive-muted pt-1">
          Recipient: <span class="text-white font-mono select-all">midhunv800@gmail.com</span>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
  const modal = document.getElementById("submitEventModal");
  const modalCard = document.getElementById("submitModalCard");
  const closeBtn = document.getElementById("closeSubmitModalBtn");
  const sendGmailBtn = document.getElementById("sendGmailBtn");
  const sendMailtoBtn = document.getElementById("sendMailtoBtn");
  const copyDetailsBtn = document.getElementById("copyDetailsBtn");
  const form = document.getElementById("submitEventForm") as HTMLFormElement | null;

  const RECIPIENT = "midhunv800@gmail.com";

  function openModal() {
    if (!modal) return;
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    setTimeout(() => {
      modal.classList.remove("opacity-0");
      modalCard?.classList.remove("scale-95");
      modalCard?.classList.add("scale-100");
    }, 10);
    document.getElementById("eventTitle")?.focus();
  }

  function closeModal() {
    if (!modal) return;
    modalCard?.classList.remove("scale-100");
    modalCard?.classList.add("scale-95");
    modal.classList.add("opacity-0");
    setTimeout(() => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    }, 200);
  }

  // Open modal triggers from anywhere in the app
  document.querySelectorAll(".open-submit-modal-btn").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.preventDefault();
      openModal();
    });
  });

  // Open modal automatically if #submit or ?submit=true in URL
  if (window.location.search.includes("submit=true") || window.location.hash === "#submit") {
    setTimeout(openModal, 100);
  }

  closeBtn?.addEventListener("click", closeModal);

  // Close on outside click
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  // Close on Escape
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
      closeModal();
    }
  });

  function getFormData() {
    const title = (document.getElementById("eventTitle") as HTMLInputElement)?.value.trim() || "";
    const organizer = (document.getElementById("eventOrganizer") as HTMLInputElement)?.value.trim() || "";
    const url = (document.getElementById("eventUrl") as HTMLInputElement)?.value.trim() || "";
    const mode = (document.getElementById("eventMode") as HTMLSelectElement)?.value || "offline";
    const city = (document.getElementById("eventCity") as HTMLInputElement)?.value.trim() || "";
    const deadline = (document.getElementById("eventDeadline") as HTMLInputElement)?.value || "";
    const startDate = (document.getElementById("eventStartDate") as HTMLInputElement)?.value || "";
    const fee = (document.getElementById("eventFee") as HTMLInputElement)?.value.trim() || "Free";
    const prize = (document.getElementById("eventPrize") as HTMLInputElement)?.value.trim() || "";
    const notes = (document.getElementById("eventNotes") as HTMLTextAreaElement)?.value.trim() || "";

    const subject = `[HackRadar Event Submission] ${title || "New Hackathon"}`;
    const body = `Hi Midhun,

I would like to submit an active hackathon to HackRadar Kerala:

- Title: ${title || "[Title]"}
- Organizer: ${organizer || "[Organizer]"}
- Website / Registration URL: ${url || "[URL]"}
- Mode: ${mode.toUpperCase()}
- City / Venue: ${city || "Kerala / Online"}
- Registration Deadline: ${deadline || "Not specified"}
- Event Date: ${startDate || "Not specified"}
- Entry Fee: ${fee}
- Prize Pool: ${prize || "N/A"}

Additional Notes / Contact:
${notes || "None"}

---
Submitted via HackRadar Kerala (hackradar-kerala.vercel.app)`;

    return { title, organizer, url, subject, body };
  }

  function validateBasic(data: { title: string; organizer: string; url: string }) {
    if (!data.title || !data.organizer || !data.url) {
      alert("Please fill in Title, Organizer, and Website URL before submitting.");
      return false;
    }
    return true;
  }

  // Helper for toast notifications if available
  function notify(msg: string) {
    const toast = document.getElementById("toastNotification");
    const msgSpan = document.getElementById("toastMessage");
    if (toast && msgSpan) {
      msgSpan.textContent = msg;
      toast.classList.remove("translate-y-20", "opacity-0");
      toast.classList.add("translate-y-0", "opacity-100");
      setTimeout(() => {
        toast.classList.remove("translate-y-0", "opacity-100");
        toast.classList.add("translate-y-20", "opacity-0");
      }, 2500);
    } else {
      alert(msg);
    }
  }

  // 1. Send via Gmail Web
  sendGmailBtn?.addEventListener("click", () => {
    const data = getFormData();
    if (!validateBasic(data)) return;
    const gmailUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(RECIPIENT)}&su=${encodeURIComponent(data.subject)}&body=${encodeURIComponent(data.body)}`;
    window.open(gmailUrl, "_blank");
    notify(`Opened Gmail composer to ${RECIPIENT}!`);
  });

  // 2. Send via mailto client
  sendMailtoBtn?.addEventListener("click", () => {
    const data = getFormData();
    if (!validateBasic(data)) return;
    const mailtoUrl = `mailto:${encodeURIComponent(RECIPIENT)}?subject=${encodeURIComponent(data.subject)}&body=${encodeURIComponent(data.body)}`;
    window.location.href = mailtoUrl;
    notify(`Opening email app to ${RECIPIENT}...`);
  });

  // 3. Copy Details to Clipboard
  copyDetailsBtn?.addEventListener("click", () => {
    const data = getFormData();
    navigator.clipboard.writeText(data.body).then(() => {
      notify("Event details copied to clipboard!");
    }).catch(() => {
      notify(`Recipient: ${RECIPIENT}`);
    });
  });
</script>
